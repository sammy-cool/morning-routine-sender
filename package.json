{
  "name": "morning-routine-sender",
  "description": "Automated morning routine email sender",
  "version": "2.3.1",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start_server": "node index.js",
    "start_nodemon_server": "nodemon index.js",
    "test:smtp": "node scripts/test-smtp.js",
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:seed": "knex seed:run",
    "db:status": "knex migrate:status",
    "seed:make-users": "knex seed:make users",
    "db:migrate-json": "node scripts/migrate-json-to-db.js",
    "test": "jest",
    "test:detect": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:syntax": "node --check index.js knexfile.js logger.js && node -e \"const fs=require('fs'),cp=require('child_process');const check=(d)=>{if(!fs.existsSync(d))return;fs.readdirSync(d,{withFileTypes:true}).forEach(e=>{const p=d+'/'+e.name;if(e.isDirectory()&&!['node_modules','coverage','logs','vendor','npm-mod','.git','dist'].includes(e.name))check(p);else if(e.isFile()&&e.name.endsWith('.js'))cp.execSync('node --check \\\"'+p+'\\\"');})};['config','controllers','db','email-core','helper','middleware','public/js','admin-renderer/js','routes','scripts','__tests__'].forEach(check);console.log('✅ Syntax validation passed for all JavaScript files.');\"",
    "deploy:verify": "node scripts/verify-deployment.js",
    "deploy:verify:deep": "node scripts/verify-deployment.js --deep"
  },
  "license": "ISC",
  "dependencies": {
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "customizable-toast-notification": "latest",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "ioredis-mock": "^8.13.0",
    "knex": "^3.1.0",
    "mjml": "^5.0.1",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.16.3",
    "validator": "^13.15.22",
    "web-push": "^3.6.7",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "pg-mem": "^3.0.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  },
  "keywords": [
    "email",
    "automation",
    "scheduler",
    "nodejs"
  ],
  "author": "Priyanshu"
}
