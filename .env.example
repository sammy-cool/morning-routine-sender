# Morning Routine Sender — Environment Variables
# Copy this file to .env and fill in real values. Every variable below was
# verified against actual `process.env.*` usage in the codebase as of this
# cleanup pass — nothing here is guessed, and nothing actually used is
# missing.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV="development"
PORT=2900
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Database (Postgres via Knex — see knexfile.js)
# ---------------------------------------------------------------------------
DB_HOST="your-db-host"
DB_PORT="5432"
DB_USER="your-db-user"
DB_PASSWORD="your-db-password"
DB_NAME="your-db-name"
DB_SSL="true"

# Used only by helper/read-db.js (a separate/legacy direct-connection path,
# not knexfile.js) — keep in sync with the DB_* values above, or update
# read-db.js to reuse the shared Knex connection instead (see audit).
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# Not currently read anywhere in code (dead documentation, kept for
# reference in case it's reintroduced): DB_CLIENT, DB_PATH

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Set to "true" to use an in-memory mock instead of a real Redis server —
# useful for local development without standing up Redis.
USE_MOCK_REDIS=true

# Connection used by config/redisClient.js (Render Redis or any managed
# provider that hands you a single connection URL):
REDIS_URL="rediss://default:password@your-redis-host:6379"

# Legacy fallback name — config/redisClient.js still checks this if
# REDIS_URL isn't set, so an existing deployment doesn't break. Rename to
# REDIS_URL above when convenient; this can be removed once you have.
# REDIS_LEAP_URL="rediss://default:password@your-redis-host:6379"

# ---------------------------------------------------------------------------
# SMTP / Email sending (config/email-config.js)
# ---------------------------------------------------------------------------
TRANSPORTER_HOST="smtp.gmail.com"
TRANSPORTER_PORT="587"
TRANSPORTER_SECURE="false"
TRANSPORTER_REQUIRE_TLS="true"
FROM_USER="your-email@gmail.com"
FROM_NAME="Morning Routine Sender"
PASSWORD="your-app-password"

SMTP_POOL_ENABLED="false"
SMTP_MAX_CONNECTIONS="3"
SMTP_MAX_MESSAGES="50"
SMTP_DEBUG="false"
SMTP_CONNECTION_TIMEOUT="10000"
SMTP_GREETING_TIMEOUT="10000"
SMTP_SOCKET_TIMEOUT="15000"
SMTP_REJECT_UNAUTHORIZED="true"
SMTP_VERIFY_ON_STARTUP="true"

# Email that failure alerts get sent to (email-core/emailJobs.js)
ADMIN_EMAIL="your-alert-inbox@gmail.com"

# Test recipients used by manual test scripts
TEST_EMAIL="your-email@gmail.com"
TEST_EMAIL_2="another-email@gmail.com"

# ---------------------------------------------------------------------------
# Admin / auth
# ---------------------------------------------------------------------------
ADMIN_KEY="change-me"
CRON_API_KEY="change-me"
ADMIN_SKIP_KEY="change-me"
ALLOWED_RATE_LIMITER="9"

# Used to sign unsubscribe links (helper/unsubscribeToken.js). Falls back
# to ADMIN_KEY if unset -- works immediately, but a dedicated secret is
# better practice since these serve different purposes.
UNSUBSCRIBE_SECRET="change-me-too"

# ---------------------------------------------------------------------------
# Retention (helper/database-cleanup.js)
# ---------------------------------------------------------------------------
DB_RETENTION_DAYS="30"

# NOTE: these are documented here for reference but are NOT currently wired
# up to any code — logger.js hardcodes maxFiles/maxSize directly, and the
# weekly cleanup cron pattern ("0 2 * * 0") is hardcoded in
# emailScheduler.js. Setting these will have no effect until that's changed.
# LOG_RETENTION_DAYS="3"
# ERROR_LOG_RETENTION_DAYS="7"
# LOG_MAX_SIZE="10m"
# LOG_MAX_FILES="3d"
# CLEANUP_CRON_SCHEDULE="0 2 * * *"

# ---------------------------------------------------------------------------
# Misc / Third-Party / AI & Push Automation
# ---------------------------------------------------------------------------
NEWS_API_KEY="your-news-api-key"
LOGO_URL="https://your-cdn/logo.png"
RENDER_URL="https://your-app.onrender.com"

# Multi-LLM Morning Spark Engine ('curated' | 'gemini' | 'openai' | 'ollama')
LLM_PROVIDER="curated"
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Multi-Channel Dispatch (Discord & Telegram)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Web Push & VAPID Notifications
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:your-email@gmail.com"

# Used only by scripts/monitor.js (standalone health-check script, not the
# main app) to know which deployed instance to poll.
BASE_URL="http://localhost:2900"

