# Add/update these lines in .env

# Mock Redis for local development (no Redis server needed)
USE_MOCK_REDIS=true

# Test email addresses
TEST_EMAIL=your-email@gmail.com
TEST_EMAIL_2=another-email@gmail.com

# Logging
LOG_LEVEL=info

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Worker Configuration
WORKER_CONCURRENCY=5

# SMTP Configuration (from previous action item)
PORT = 0000
TRANSPORTER_HOST = xyz.service.com
TRANSPORTER_PORT = 000
TRANSPORTER_SECURE = false
FROM_USER = 'FROM_EMAIL'
PASSWORD = 'PASSWORD'
TO_USER = 'TO_EMAIL'
DOMAIN = 'DOMAIN_NAME'
CRON_API_KEY = 'YOUR_SECRET_KEY'

# Database Configuration

# For production Postgres migration
# DB_CLIENT=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=your_user
# DB_PASSWORD=your_password
# DB_NAME=morning_routine_sender

# For development Postgres migration
# DB_CLIENT=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=your_user
# DB_PASSWORD=your_password
# DB_NAME=morning_routine_sender

# SMTP Configuration
TRANSPORTER_HOST=smtp.gmail.com
TRANSPORTER_PORT=587
TRANSPORTER_SECURE=false
TRANSPORTER_REQUIRE_TLS=true
FROM_USER=your-email@gmail.com
PASSWORD=your-app-password
FROM_NAME=Morning Routine Sender

# Connection Settings
SMTP_CONNECTION_TIMEOUT=10000
SMTP_GREETING_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=20000

# Pool Settings (for high volume)
SMTP_POOL_ENABLED=true
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100

# Security
SMTP_REJECT_UNAUTHORIZED=true

# Database Configuration
DB_CLIENT=sqlite3
DB_PATH=./storage/email-tracker.db

