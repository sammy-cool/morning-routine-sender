{
  "$schema": "https://json.schemastore.org/web-manifest.json",
  "id": "/?source=pwa",
  "name": "Morning Routine Sender",
  "short_name": "MRSender",
  "description": "Daily automated morning routine emails, habit streak tracking, focus sprint timer, and curated mindset tracks.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#050608",
  "theme_color": "#050608",
  "lang": "en-US",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "48x48 32x32 16x16",
      "type": "image/x-icon",
      "purpose": "any"
    },
    {
      "src": "/assets/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/assets/mrn-brand-ico.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/mrn-brand-ico.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/assets/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Morning Routine Sender Desktop Dashboard"
    },
    {
      "src": "/assets/screenshot-mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Morning Routine Sender Mobile Interface"
    }
  ],
  "categories": ["productivity", "lifestyle", "utilities"],
  "shortcuts": [
    {
      "name": "Subscribe to Routine",
      "url": "/#signupView",
      "description": "Join daily morning routine email dispatch"
    },
    {
      "name": "Subscriber Portal",
      "url": "/user-dashboard",
      "description": "Manage routine schedule and tracks"
    },
    {
      "name": "Live Routine Companion",
      "url": "/routine",
      "description": "Open focus timer and ambient soundscapes"
    },
    {
      "name": "About Morning Routine",
      "url": "/about",
      "description": "Learn about the mission, architecture, and creator"
    }
  ]
}
