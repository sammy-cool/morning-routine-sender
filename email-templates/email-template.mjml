<mjml>
  <mj-head>
    <mj-title>Morning Routine • Daily Focus &amp; Inspiration</mj-title>
    <mj-preview>Your tailored morning routine &amp; habit ritual is ready</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" color="#1e293b" />
      <mj-class name="headline" font-size="28px" font-weight="800" line-height="34px" color="#0f172a" align="center" />
      <mj-class name="subhead" font-size="16px" font-weight="600" color="#6366f1" align="center" />
      <mj-class name="quote" font-size="17px" font-style="italic" line-height="26px" color="#334155" />
      <mj-class name="body-text" font-size="15px" line-height="24px" color="#475569" />
      <mj-class name="btn-primary" background-color="#6366f1" color="#ffffff" font-size="15px" font-weight="700" border-radius="12px" inner-padding="14px 28px" />
      <mj-class name="btn-streak" background-color="#10b981" color="#ffffff" font-size="14px" font-weight="700" border-radius="10px" inner-padding="12px 22px" />
    </mj-attributes>
    <mj-style inline="inline">
      .brand-badge {
        display: inline-block;
        padding: 4px 14px;
        background-color: #e0e7ff;
        color: #4338ca;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        margin: 0 4px;
      }
      .streak-badge {
        display: inline-block;
        padding: 4px 14px;
        background-color: #fef3c7;
        color: #b45309;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin: 0 4px;
      }
      .card-box {
        background-color: #ffffff;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      }
      .quote-container {
        border-left: 4px solid #6366f1;
        padding-left: 16px;
        margin: 12px 0;
      }
      .news-card {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 14px;
        margin-bottom: 10px;
      }
      @media only screen and (max-width: 480px) {
        .mobile-pad { padding: 16px !important; }
        .headline { font-size: 22px !important; line-height: 28px !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f1f5f9" width="600px">
    <!-- Spacer -->
    <mj-section padding="20px 0 10px 0"></mj-section>

    <!-- Main Card -->
    <mj-wrapper background-color="#ffffff" border-radius="20px" padding="30px 24px" css-class="card-box">
      <!-- Header / Logo / Badges -->
      <mj-section padding="0 0 20px 0">
        <mj-column>
          <mj-text align="center">
            <span class="brand-badge">{{trackBadge}}</span>
            <span class="streak-badge">🔥 {{streakBadge}}</span>
          </mj-text>
          <mj-text mj-class="headline" padding="14px 0 6px 0">
            Rise. Focus. Make Today Count.
          </mj-text>
          <mj-text mj-class="subhead" padding="0">
            Good morning, {{userName}}!
          </mj-text>
          <mj-divider border-width="1px" border-color="#f1f5f9" padding="20px 0 10px 0" width="80%" />
        </mj-column>
      </mj-section>

      <!-- Daily Motivation Quote -->
      <mj-section padding="0 0 15px 0">
        <mj-column>
          <mj-text mj-class="quote" padding="0 10px">
            <div class="quote-container">
              “{{dailyQuote}}”
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Dynamic AI Morning Spark & Micro-Action Kickoff -->
      <mj-section padding="0 0 18px 0">
        <mj-column>
          <div style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.07) 0%, rgba(6, 182, 212, 0.07) 100%); border: 1px solid rgba(99, 102, 241, 0.22); border-radius: 14px; padding: 16px 18px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <span style="font-size: 11px; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.8px;">
                ⚡ Daily Kickoff • {{aiSourceBadge}}
              </span>
              <span style="font-size: 11px; font-weight: 700; color: #047857; background: #ecfdf5; padding: 2px 8px; border-radius: 10px; border: 1px solid #a7f3d0;">
                Mantra: "{{aiFocusMantra}}"
              </span>
            </div>
            <div style="font-size: 14px; color: #1e293b; line-height: 22px; font-weight: 500; margin-bottom: 10px;">
              {{aiSparkReflection}}
            </div>
            <div style="background: #ffffff; border-left: 3px solid #10b981; border-radius: 6px; padding: 8px 12px;">
              <span style="font-size: 11px; font-weight: 800; color: #065f46; text-transform: uppercase;">🚀 2-Min Micro-Action:</span>
              <div style="font-size: 13px; color: #334155; margin-top: 2px; line-height: 18px;">
                {{aiMicroAction}}
              </div>
            </div>
          </div>
        </mj-column>
      </mj-section>

      <!-- Actionable Focus Tip -->
      <mj-section padding="0 0 15px 0">
        <mj-column>
          <mj-text font-size="16px" font-weight="700" color="#0f172a" padding="0 0 8px 0">
            🎯 Today's Actionable Ritual
          </mj-text>
          <mj-text mj-class="body-text" padding="0 0 20px 0">
            {{dailyTip}}
          </mj-text>
          <mj-button mj-class="btn-primary" href="{{ctaUrl}}" align="center">
            {{ctaText}} →
          </mj-button>
        </mj-column>
      </mj-section>

      <!-- Habit Streak Check-in Callout -->
      <mj-section padding="10px 0 20px 0">
        <mj-column>
          <mj-text align="center" font-size="13px" color="#64748b" padding="0 0 10px 0">
            Completed your morning ritual? Log today's progress with 1 click:
          </mj-text>
          <mj-button mj-class="btn-streak" href="{{checkinUrl}}" align="center">
            ⚡ I Completed My Routine (Maintain Streak)
          </mj-button>
        </mj-column>
      </mj-section>

      <!-- Trending News Section (Conditional) -->
      {{#if trendingNews}}
      <mj-section padding="10px 0 10px 0">
        <mj-column>
          <mj-divider border-width="1px" border-color="#f1f5f9" padding="0 0 16px 0" />
          <mj-text font-size="16px" font-weight="700" color="#0f172a" padding="0 0 12px 0">
            ⚡ Trending Insights for Today
          </mj-text>
          {{#each trendingNews}}
          <mj-text padding="0 0 12px 0">
            <div class="news-card">
              <a href="{{this.url}}" style="color: #6366f1; text-decoration: none; font-weight: 700; font-size: 15px;">
                {{this.title}} →
              </a>
              <div style="font-size: 13px; color: #64748b; margin-top: 6px; line-height: 1.5;">
                {{this.description}}
              </div>
            </div>
          </mj-text>
          {{/each}}
        </mj-column>
      </mj-section>
      {{/if}}

      <!-- Footer Note -->
      <mj-section padding="20px 0 0 0">
        <mj-column>
          <mj-divider border-width="1px" border-color="#f1f5f9" padding="0 0 16px 0" />
          <mj-text align="center" font-size="12px" color="#94a3b8" line-height="18px" padding="0">
            You received this email because you subscribed to <strong>Morning Routine</strong>.<br />
            <a href="{{preferencesUrl}}" style="color: #6366f1; text-decoration: none; font-weight: 600;">Manage Preferences</a>
            &nbsp;•&nbsp;
            <a href="{{unsubscribeUrl}}" style="color: #94a3b8; text-decoration: underline;">Unsubscribe</a>
          </mj-text>
          <mj-text align="center" font-size="11px" color="#cbd5e1" padding="10px 0 0 0">
            &copy; {{year}} Morning Routine Sender • All rights reserved.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- Bottom Spacing -->
    <mj-section padding="20px 0"></mj-section>
  </mj-body>
</mjml>
