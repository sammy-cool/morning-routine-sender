<mjml>
  <mj-head>
    <mj-title>Morning Routine • Daily Focus &amp; Inspiration</mj-title>
    <mj-preview>Your tailored morning routine &amp; habit ritual is ready</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" color="#1e293b" />
      <mj-class name="headline" font-size="28px" font-weight="800" line-height="34px" color="#0f172a" align="center" />
      <mj-class name="subhead" font-size="16px" font-weight="600" color="#7c3aed" align="center" />
      <mj-class name="quote" font-size="17px" font-style="italic" line-height="26px" color="#334155" />
      <mj-class name="body-text" font-size="15px" line-height="24px" color="#475569" />
      <mj-class name="btn-primary" background-color="#7c3aed" color="#ffffff" font-size="15px" font-weight="700" border-radius="12px" inner-padding="14px 28px" />
      <mj-class name="btn-streak" background-color="#10b981" color="#ffffff" font-size="14px" font-weight="700" border-radius="10px" inner-padding="12px 22px" />
    </mj-attributes>
    <mj-style inline="inline">
      .brand-badge {
        display: inline-block;
        padding: 4px 14px;
        background-color: #ede9fe;
        color: #6d28d9;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        margin: 0 4px;
      }
      .streak-badge {
        display: inline-block;
        padding: 4px 14px;
        background-color: #fef3c7;
        color: #b45309;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin: 0 4px;
      }
      .card-box {
        background-color: #ffffff;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      }
      .quote-container {
        border-left: 4px solid #7c3aed;
        padding-left: 16px;
        margin: 12px 0;
      }
      .news-card {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 14px;
        margin-bottom: 10px;
      }
      .companion-chip {
        display: inline-block;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        padding: 6px 14px;
        border-radius: 20px;
        margin: 3px 4px;
      }
      @media only screen and (max-width: 480px) {
        .mobile-pad { padding: 16px !important; }
        .headline { font-size: 22px !important; line-height: 28px !important; }
        .companion-chip { display: block !important; margin: 6px auto !important; max-width: 200px !important; }
      }
      @media (prefers-color-scheme: dark) {
        .card-box { background-color: #0f172a !important; }
        .headline { color: #f8fafc !important; }
        .body-text { color: #cbd5e1 !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f1f5f9" width="600px">
    <!-- Spacer -->
    <mj-section padding="20px 0 10px 0"></mj-section>

    <!-- Main Card -->
    <mj-wrapper background-color="#ffffff" border-radius="20px" padding="30px 24px" css-class="card-box">
      <!-- Broadcast Announcement Banner (if active) -->
      {{#if announcement}}
      <mj-section padding="0 0 15px 0">
        <mj-column>
          <mj-text padding="0 10px">
            <div style="background: #eff6ff; border: 1px solid #93c5fd; border-left: 4px solid #3b82f6; border-radius: 10px; padding: 12px 14px;">
              <span style="font-size: 11px; font-weight: 800; color: #1d4ed8; text-transform: uppercase;">📢 {{announcement.title}}</span>
              <div style="font-size: 13px; color: #1e3a8a; margin-top: 4px; line-height: 18px;">{{announcement.message}}</div>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>
      {{/if}}

      <!-- Localized Weather Spark (if available) -->
      {{#if weatherSpark}}
      <mj-section padding="0 0 10px 0">
        <mj-column>
          <mj-text align="center" padding="0 10px">
            <div style="display: inline-block; font-size: 12px; font-weight: 600; color: #475569; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 20px; padding: 5px 14px;">
              {{weatherSpark.formattedSpark}}
            </div>
          </mj-text>
        </mj-column>
      </mj-section>
      {{/if}}

      <!-- Header / Logo / Badges -->
      <mj-section padding="0 0 16px 0">
        <mj-column>
          <mj-image
            src="{{logoUrl}}"
            alt="Morning Routine"
            width="44px"
            height="44px"
            align="center"
            padding="0 0 12px 0"
            border-radius="12px"
          />
          <mj-text align="center">
            <span class="brand-badge">{{trackBadge}}</span>
            <span class="streak-badge">🔥 {{streakBadge}}</span>
          </mj-text>
          <mj-text mj-class="headline" padding="12px 0 6px 0">
            Rise. Focus. Make Today Count.
          </mj-text>
          <mj-text mj-class="subhead" padding="0">
            Good morning, {{userName}}!
          </mj-text>
          <mj-divider border-width="1px" border-color="#f1f5f9" padding="16px 0 10px 0" width="80%" />
        </mj-column>
      </mj-section>

      <!-- Streak Momentum & Milestone Bar -->
      <mj-section padding="0 0 15px 0">
        <mj-column>
          <mj-text padding="0 10px">
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 12px 14px;">
              <table width="100%" border="0" cellpadding="0" cellspacing="0" style="font-family: inherit;">
                <tr>
                  <td align="left" style="font-size: 12px; font-weight: 700; color: #0f172a;">
                    🔥 Streak Momentum: <span style="color: #d97706;">{{streakBadge}}</span>
                  </td>
                  <td align="right" style="font-size: 11px; font-weight: 600; color: #64748b;">
                    Next: {{nextMilestoneName}} ({{nextMilestoneDaysRemaining}}d left)
                  </td>
                </tr>
                <tr>
                  <td colspan="2" style="padding-top: 8px;">
                    <div style="height: 6px; background: #e2e8f0; border-radius: 99px; overflow: hidden;">
                      <div style="height: 100%; width: {{streakProgressPct}}%; background: #10b981; border-radius: 99px;"></div>
                    </div>
                  </td>
                </tr>
              </table>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Daily Motivation Quote -->
      <mj-section padding="0 0 15px 0">
        <mj-column>
          <mj-text mj-class="quote" padding="0 10px">
            <div class="quote-container">
              “{{dailyQuote}}”
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Dynamic AI Morning Spark & Micro-Action Kickoff -->
      <mj-section padding="0 0 18px 0">
        <mj-column>
          <mj-text padding="0 10px">
            <div style="background: linear-gradient(135deg, rgba(124, 58, 237, 0.08) 0%, rgba(34, 211, 238, 0.08) 100%); border: 1px solid rgba(124, 58, 237, 0.25); border-radius: 14px; padding: 16px 18px;">
              <div style="margin-bottom: 8px;">
                <span style="font-size: 11px; font-weight: 800; color: #6d28d9; text-transform: uppercase; letter-spacing: 0.8px;">
                  ⚡ Daily Kickoff • {{aiSourceBadge}}
                </span>
                <span style="font-size: 11px; font-weight: 700; color: #047857; background: #ecfdf5; padding: 2px 8px; border-radius: 10px; border: 1px solid #a7f3d0; margin-left: 8px;">
                  Mantra: "{{aiFocusMantra}}"
                </span>
              </div>
              <div style="font-size: 14px; color: #1e293b; line-height: 22px; font-weight: 500; margin-bottom: 10px;">
                {{aiSparkReflection}}
              </div>
              <div style="background: #ffffff; border-left: 3px solid #10b981; border-radius: 6px; padding: 8px 12px;">
                <span style="font-size: 11px; font-weight: 800; color: #065f46; text-transform: uppercase;">🚀 2-Min Micro-Action:</span>
                <div style="font-size: 13px; color: #334155; margin-top: 2px; line-height: 18px;">
                  {{aiMicroAction}}
                </div>
              </div>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Actionable Focus Tip -->
      <mj-section padding="0 0 15px 0">
        <mj-column>
          <mj-text font-size="16px" font-weight="700" color="#0f172a" padding="0 0 8px 0">
            🎯 Today's Actionable Ritual
          </mj-text>
          <mj-text mj-class="body-text" padding="0 0 20px 0">
            {{dailyTip}}
          </mj-text>
          <mj-button mj-class="btn-primary" href="{{ctaUrl}}" align="center">
            {{ctaText}} →
          </mj-button>
        </mj-column>
      </mj-section>

      <!-- Daily Habit Architecture Checklist -->
      {{#if hasChecklist}}
      <mj-section padding="0 0 16px 0">
        <mj-column>
          <mj-text font-size="15px" font-weight="700" color="#0f172a" padding="0 10px 8px 10px">
            📋 Today's Habit Architecture
          </mj-text>
          <mj-text padding="0 10px">
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 10px 14px;">
              {{#each checklist}}
              <div style="padding: 6px 0; border-bottom: 1px solid #f1f5f9; font-size: 13.5px; font-weight: 600; color: #334155;">
                <span style="color: #7c3aed; margin-right: 8px; font-weight: 800;">✦</span> {{this}}
              </div>
              {{/each}}
            </div>
          </mj-text>
        </mj-column>
      </mj-section>
      {{/if}}

      <!-- Daily MERN Stack Deep-Dive & Mental Model (Dynamic & Non-Repeating) -->
      {{#if mernInsight}}
      <mj-section padding="0 0 16px 0">
        <mj-column>
          <mj-text font-size="15px" font-weight="700" color="#0f172a" padding="0 10px 8px 10px">
            💻 Daily MERN Stack Deep-Dive • {{mernInsight.pillarIcon}} {{mernInsight.category}}
          </mj-text>
          <mj-text padding="0 10px">
            <div style="background: #0f172a; border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 14px; padding: 16px 18px; color: #f8fafc;">
              <div style="margin-bottom: 8px;">
                <span style="font-size: 11px; font-weight: 800; color: #38bdf8; text-transform: uppercase; letter-spacing: 0.8px; background: rgba(56, 189, 248, 0.12); padding: 3px 10px; border-radius: 12px; border: 1px solid rgba(56, 189, 248, 0.3);">
                  {{mernInsight.pillarIcon}} {{mernInsight.category}} • Lesson #{{mernInsight.sequenceNumber}}/{{mernInsight.totalLessons}}
                </span>
                {{#if mernInsight.isMasteryReview}}
                <span style="font-size: 10px; font-weight: 800; color: #a78bfa; background: rgba(167, 139, 250, 0.15); padding: 2px 8px; border-radius: 10px; border: 1px solid rgba(167, 139, 250, 0.3); margin-left: 6px;">
                  🏆 Mastery Review
                </span>
                {{/if}}
              </div>
              <div style="font-size: 15px; font-weight: 700; color: #f8fafc; margin-top: 6px; line-height: 22px;">
                {{mernInsight.title}}
              </div>
              <div style="font-size: 13.5px; color: #94a3b8; line-height: 20px; margin-top: 6px;">
                <strong style="color: #cbd5e1;">🧠 Core Mental Model:</strong> {{mernInsight.mentalModel}}
              </div>
              {{#if mernInsight.codeIllustration}}
              <div style="background: #030712; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 10px 12px; margin: 10px 0; font-family: 'JetBrains Mono', monospace; font-size: 11.5px; color: #38bdf8; overflow-x: auto; line-height: 1.45;">
                <pre style="margin: 0; white-space: pre-wrap; word-break: break-word; font-family: inherit;"><code>{{mernInsight.codeIllustration}}</code></pre>
              </div>
              {{/if}}
              <div style="background: rgba(16, 185, 129, 0.08); border-left: 3px solid #10b981; border-radius: 6px; padding: 8px 12px; margin-top: 6px;">
                <span style="font-size: 11px; font-weight: 800; color: #34d399; text-transform: uppercase;">⚡ Key Takeaway:</span>
                <div style="font-size: 13px; color: #e2e8f0; margin-top: 2px; line-height: 18px;">
                  {{mernInsight.takeaway}}
                </div>
              </div>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>
      {{/if}}

      <!-- Habit Streak Check-in Callout -->
      <mj-section padding="10px 0 12px 0">
        <mj-column>
          <mj-text align="center" font-size="13px" color="#64748b" padding="0 0 10px 0">
            Completed your morning ritual? Log today's progress with 1 click:
          </mj-text>
          <mj-button mj-class="btn-streak" href="{{checkinUrl}}" align="center">
            ⚡ I Completed My Routine (Maintain Streak)
          </mj-button>
        </mj-column>
      </mj-section>

      <!-- Quick Companion Tools Bar -->
      <mj-section padding="0 0 16px 0">
        <mj-column>
          <mj-text align="center" padding="0 10px">
            <div style="text-align: center; margin-top: 2px;">
              <a href="{{wallpaperUrl}}" class="companion-chip" target="_blank">
                📱 Lockscreen Wallpaper
              </a>
              <a href="{{audioBriefingUrl}}" class="companion-chip" target="_blank">
                🎙️ Voice Spark
              </a>
              <a href="{{squadUrl}}" class="companion-chip" target="_blank">
                👥 Squad &amp; Duel
              </a>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Trending News Section (Conditional) -->
      {{#if trendingNews}}
      <mj-section padding="10px 0 10px 0">
        <mj-column>
          <mj-divider border-width="1px" border-color="#f1f5f9" padding="0 0 16px 0" />
          <mj-text font-size="16px" font-weight="700" color="#0f172a" padding="0 0 12px 0">
            ⚡ Trending Insights for Today
          </mj-text>
          {{#each trendingNews}}
          <mj-text padding="0 0 12px 0">
            <div class="news-card">
              <a href="{{this.url}}" style="color: #7c3aed; text-decoration: none; font-weight: 700; font-size: 15px;">
                {{this.title}} →
              </a>
              <div style="font-size: 13px; color: #64748b; margin-top: 6px; line-height: 1.5;">
                {{this.description}}
              </div>
            </div>
          </mj-text>
          {{/each}}
        </mj-column>
      </mj-section>
      {{/if}}

      <!-- Footer Note -->
      <mj-section padding="20px 0 0 0">
        <mj-column>
          <mj-divider border-width="1px" border-color="#f1f5f9" padding="0 0 16px 0" />
          <mj-text align="center" font-size="12px" color="#94a3b8" line-height="18px" padding="0">
            You received this email because you subscribed to <strong>Morning Routine</strong>.<br />
            <a href="{{preferencesUrl}}" style="color: #7c3aed; text-decoration: none; font-weight: 600;">Manage Preferences</a>
            &nbsp;•&nbsp;
            <a href="{{unsubscribeUrl}}" style="color: #94a3b8; text-decoration: underline;">Unsubscribe</a>
          </mj-text>
          <mj-text align="center" font-size="11px" color="#cbd5e1" padding="10px 0 0 0">
            &copy; {{year}} Morning Routine Sender • All rights reserved.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- Bottom Spacing -->
    <mj-section padding="20px 0"></mj-section>
  </mj-body>
</mjml>
