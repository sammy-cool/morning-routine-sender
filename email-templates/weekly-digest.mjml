<mjml>
  <mj-head>
    <mj-title>Sunday Streak Digest • Weekly Recap & Week Prep</mj-title>
    <mj-preview>🔥 {{streakBadge}} Recap • Your Sunday Persona Guidance & Upcoming Week Prep</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" color="#1e293b" />
      <mj-class name="headline" font-size="28px" font-weight="800" line-height="34px" color="#0f172a" align="center" />
      <mj-class name="subhead" font-size="16px" font-weight="600" color="#6366f1" align="center" />
      <mj-class name="quote" font-size="16px" font-style="italic" line-height="24px" color="#334155" />
      <mj-class name="body-text" font-size="15px" line-height="24px" color="#475569" />
      <mj-class name="btn-primary" background-color="#6366f1" color="#ffffff" font-size="15px" font-weight="700" border-radius="12px" inner-padding="14px 28px" />
      <mj-class name="btn-streak" background-color="#10b981" color="#ffffff" font-size="14px" font-weight="700" border-radius="10px" inner-padding="12px 22px" />
    </mj-attributes>
    <mj-style inline="inline">
      .brand-badge {
        display: inline-block;
        padding: 4px 14px;
        background-color: #e0e7ff;
        color: #4338ca;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        margin: 0 4px;
      }
      .streak-badge {
        display: inline-block;
        padding: 4px 14px;
        background-color: #fef3c7;
        color: #b45309;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin: 0 4px;
      }
      .card-box {
        background-color: #ffffff;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      }
      .recap-container {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 20px;
        margin: 10px 0 20px 0;
        text-align: center;
      }
      .day-pill {
        display: inline-block;
        width: 30px;
        height: 30px;
        line-height: 30px;
        border-radius: 50%;
        font-size: 11px;
        font-weight: 700;
        text-align: center;
        background: #10b981;
        color: #ffffff;
        margin: 0 2px;
      }
      .persona-box {
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.08), rgba(6, 182, 212, 0.05));
        border-left: 4px solid #6366f1;
        border-radius: 12px;
        padding: 16px;
        margin: 12px 0 20px 0;
      }
      .prep-item {
        padding: 10px 14px;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        margin-bottom: 8px;
        font-size: 14px;
        color: #334155;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f1f5f9" width="600px">
    <mj-section padding="20px 0 10px 0"></mj-section>

    <mj-wrapper background-color="#ffffff" border-radius="20px" padding="30px 24px" css-class="card-box">
      <!-- Header / Badges -->
      <mj-section padding="0 0 16px 0">
        <mj-column>
          <mj-text align="center">
            <span class="brand-badge">{{trackBadge}}</span>
            <span class="streak-badge">🔥 {{streakBadge}}</span>
          </mj-text>
          <mj-text mj-class="headline" padding="14px 0 6px 0">
            Sunday Weekly Streak Digest
          </mj-text>
          <mj-text mj-class="subhead" padding="0">
            Reflect, Recharge &amp; Plan with Intentionality
          </mj-text>
          <mj-divider border-width="1px" border-color="#f1f5f9" padding="18px 0 10px 0" width="80%" />
        </mj-column>
      </mj-section>

      <!-- Weekly Streak Recap Card -->
      <mj-section padding="0 0 15px 0">
        <mj-column>
          <mj-text padding="0 10px">
            <div class="recap-container">
              <div style="font-size: 13px; font-weight: 700; color: #6366f1; text-transform: uppercase; letter-spacing: 0.5px;">
                📊 Weekly Momentum Summary
              </div>
              <div style="font-size: 32px; font-weight: 800; color: #0f172a; margin: 8px 0 4px 0;">
                {{streakCount}} Consecutive Days
              </div>
              <div style="font-size: 14px; color: #64748b;">
                {{streakEncouragement}}
              </div>
              <div style="margin-top: 14px;">
                <span style="font-size: 12px; font-weight: 600; color: #94a3b8;">7-Day Habit Completion:</span>
                <div style="margin-top: 6px;">
                  <span class="day-pill">M</span>
                  <span class="day-pill">T</span>
                  <span class="day-pill">W</span>
                  <span class="day-pill">T</span>
                  <span class="day-pill">F</span>
                  <span class="day-pill">S</span>
                  <span class="day-pill">S</span>
                </div>
              </div>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Personalized Persona Guidance -->
      <mj-section padding="0 0 15px 0">
        <mj-column>
          <mj-text font-size="17px" font-weight="700" color="#0f172a" padding="0 0 8px 0">
            🧘 {{trackName}} Sunday Reflection
          </mj-text>
          <mj-text padding="0 10px">
            <div class="persona-box">
              <div style="font-size: 14px; font-weight: 700; color: #4338ca; margin-bottom: 6px;">
                💡 Weekly Persona Focus:
              </div>
              <div style="font-size: 14px; line-height: 1.6; color: #1e293b; font-style: italic;">
                “{{weeklyQuote}}”
              </div>
              <div style="font-size: 14px; line-height: 1.6; color: #334155; margin-top: 10px;">
                {{weeklyReflectionGuidance}}
              </div>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Upcoming Week Prep -->
      <mj-section padding="0 0 15px 0">
        <mj-column>
          <mj-text font-size="17px" font-weight="700" color="#0f172a" padding="0 0 10px 0">
            🎯 Upcoming Week Strategic Prep
          </mj-text>
          <mj-text mj-class="body-text" padding="0 0 12px 0">
            Prime your calendar and mind for maximum focus before Monday begins:
          </mj-text>
          {{#each weeklyPrepItems}}
          <mj-text padding="0 10px 8px 10px">
            <div class="prep-item">
              <strong>{{this.title}}:</strong> {{this.description}}
            </div>
          </mj-text>
          {{/each}}
        </mj-column>
      </mj-section>

      <!-- Direct CTAs -->
      <mj-section padding="10px 0 20px 0">
        <mj-column>
          <mj-button mj-class="btn-primary" href="{{ctaUrl}}" align="center">
            ⚡ Open Interactive Routine &amp; Focus Timer →
          </mj-button>
          <mj-button mj-class="btn-streak" href="{{checkinUrl}}" align="center" padding="10px 0 0 0">
            🔥 Log Sunday Routine &amp; Lock In Streak
          </mj-button>
        </mj-column>
      </mj-section>

      <!-- Footer Note -->
      <mj-section padding="20px 0 0 0">
        <mj-column>
          <mj-divider border-width="1px" border-color="#f1f5f9" padding="0 0 16px 0" />
          <mj-text align="center" font-size="12px" color="#94a3b8" line-height="18px" padding="0">
            You received this Sunday digest because you subscribed to <strong>Morning Routine</strong>.<br />
            <a href="{{preferencesUrl}}" style="color: #6366f1; text-decoration: none; font-weight: 600;">Manage Preferences</a>
            &nbsp;•&nbsp;
            <a href="{{unsubscribeUrl}}" style="color: #94a3b8; text-decoration: underline;">Unsubscribe</a>
          </mj-text>
          <mj-text align="center" font-size="11px" color="#cbd5e1" padding="10px 0 0 0">
            &copy; {{year}} Morning Routine Sender • All rights reserved.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section padding="20px 0"></mj-section>
  </mj-body>
</mjml>
